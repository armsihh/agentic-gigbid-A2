    "get_free_slots": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Find free interview slots in the freelancer's working hours (weekdays 09:00-18:00).",
      "inputSchema": {
        "properties": {
          "duration_minutes": {
            "default": 30,
            "maximum": 240,
            "minimum": 15,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "end_date": {
            "description": "Last day to search (YYYY-MM-DD), at most 21 days after start",
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "max_slots": {
            "default": 3,
            "maximum": 10,
            "minimum": 1,
            "title": "Max Slots",
            "type": "integer"
          },
          "start_date": {
            "description": "First day to search (YYYY-MM-DD)",
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "IANA timezone for the result; default: freelancer's",
            "title": "Timezone"
          }
        },
        "required": [
          "start_date",
          "end_date"
        ],
        "title": "get_free_slotsArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "Slot": {
            "properties": {
              "end": {
                "title": "End",
                "type": "string"
              },
              "start": {
                "description": "ISO datetime with offset",
                "title": "Start",
                "type": "string"
              },
              "timezone": {
                "title": "Timezone",
                "type": "string"
              }
            },
            "required": [
              "start",
              "end",
              "timezone"
            ],
            "title": "Slot",
            "type": "object"
          }
        },
        "properties": {
          "slots": {
            "items": {
              "$ref": "#/$defs/Slot"
            },
            "title": "Slots",
            "type": "array"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "timezone",
          "slots"
        ],
        "title": "SlotList",
        "type": "object"
      }
    },
