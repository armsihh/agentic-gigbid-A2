    "create_email_draft": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Save an email DRAFT in the freelancer's mailbox. Never sends.",
      "inputSchema": {
        "properties": {
          "body": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "subject": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "to": {
            "maxLength": 320,
            "minLength": 3,
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "to",
          "subject",
          "body",
          "idempotency_key"
        ],
        "title": "create_email_draftArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "EmailDraft": {
            "properties": {
              "body": {
                "title": "Body",
                "type": "string"
              },
              "draft_id": {
                "title": "Draft Id",
                "type": "string"
              },
              "status": {
                "default": "draft",
                "title": "Status",
                "type": "string"
              },
              "subject": {
                "title": "Subject",
                "type": "string"
              },
              "to": {
                "title": "To",
                "type": "string"
              }
            },
            "required": [
              "draft_id",
              "to",
              "subject",
              "body"
            ],
            "title": "EmailDraft",
            "type": "object"
          },
          "Hold": {
            "properties": {
              "end": {
                "title": "End",
                "type": "string"
              },
              "hold_id": {
                "title": "Hold Id",
                "type": "string"
              },
              "start": {
                "title": "Start",
                "type": "string"
              },
              "status": {
                "description": "Always 'tentative' until the human confirms in their calendar",
                "title": "Status",
                "type": "string"
              },
              "thread_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Thread Id"
              },
              "title": {
                "title": "Title",
                "type": "string"
              }
            },
            "required": [
              "hold_id",
              "title",
              "start",
              "end",
              "status"
            ],
            "title": "Hold",
            "type": "object"
          }
        },
        "properties": {
          "draft": {
            "anyOf": [
              {
                "$ref": "#/$defs/EmailDraft"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "hold": {
            "anyOf": [
              {
                "$ref": "#/$defs/Hold"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "dry_run"
        ],
        "title": "WorkspaceWriteResult",
        "type": "object"
      }
    },
